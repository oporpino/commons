#!/usr/bin/env bash
set -euo pipefail

DUMP_FILE="${1:-}"
HOST="${2:-database}"
PORT="${3:-5432}"
DATABASE="${4:-}"
USERNAME="${5:-postgres}"
PASSWORD="${6:-postgres}"

if [ -z "$DUMP_FILE" ]; then
  echo "Usage: .commons/bin/db/load <dump_file> <host> <port> <database> <username> <password>"
  exit 1
fi

if [ ! -f "$DUMP_FILE" ]; then
  echo "File not found: $DUMP_FILE"
  exit 1
fi

PSQL="psql -h $HOST -p $PORT -U $USERNAME $DATABASE"

TOKEN=$(grep -m1 '\\restrict ' "$DUMP_FILE" | awk '{print $2}' || true)

case "$DUMP_FILE" in
  *.zip) EXTRACT="unzip -p $DUMP_FILE" ;;
  *.gz)  EXTRACT="gunzip -c $DUMP_FILE" ;;
  *)     EXTRACT="cat $DUMP_FILE" ;;
esac

echo "  → restoring $DUMP_FILE into $HOST/$DATABASE..."

if [ -n "$TOKEN" ]; then
  PGPASSWORD="$PASSWORD" sh -c "{ printf '\\\\unrestrict %s\n' '$TOKEN'; $EXTRACT | grep -vF \"\\\\restrict $TOKEN\"; } | $PSQL"
else
  PGPASSWORD="$PASSWORD" sh -c "$EXTRACT | $PSQL"
fi

echo "  ✓ done"
