#!/usr/bin/env bash

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ENV_NAME=$1

# Validate environment name is provided
if [ -z "$ENV_NAME" ]; then
  echo ""
  echo -e "${RED}ERROR: Environment name not provided${NC}"
  echo "Usage: start_with_remote_db <environment>"
  echo "Valid environments: staging, production"
  echo ""
  echo "Examples:"
  echo "  make run.server.remote staging"
  echo "  make run.server.remote production"
  echo ""
  exit 1
fi

# Validate only staging or production
if [ "$ENV_NAME" != "staging" ] && [ "$ENV_NAME" != "production" ]; then
  echo ""
  echo -e "${RED}ERROR: Invalid environment '$ENV_NAME'${NC}"
  echo "Valid environments: staging, production"
  echo ""
  exit 1
fi

# Check if DATABASE_URL_STAGING or DATABASE_URL_PRODUCTION is set
ENV_VAR_NAME="DATABASE_URL_$(echo $ENV_NAME | tr '[:lower:]' '[:upper:]')"
DATABASE_URL_VALUE="${!ENV_VAR_NAME}"

if [ -z "$DATABASE_URL_VALUE" ]; then
  echo ""
  echo -e "${RED}ERROR: $ENV_VAR_NAME not defined${NC}"
  echo "Please add it to your .env file:"
  echo ""
  echo -e "${YELLOW}$ENV_VAR_NAME=postgresql://user:pass@host:5432/dbname${NC}"
  echo ""
  exit 1
fi

echo ""
if [ "$ENV_NAME" = "production" ]; then
  echo -e "${RED}╔════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║  ⚠️  WARNING: Connected to PRODUCTION database!          ║${NC}"
  echo -e "${RED}║  All changes will be REAL and PERMANENT!                 ║${NC}"
  echo -e "${RED}╚════════════════════════════════════════════════════════════╝${NC}"
  echo ""
fi
echo -e "${GREEN}Starting Rails server with $ENV_NAME database...${NC}"
echo "Using: $ENV_VAR_NAME"
echo ""

export DATABASE_URL="$DATABASE_URL_VALUE"
bundle exec rails server -p ${PORT:-3000} -b 0.0.0.0
