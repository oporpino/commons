#!/usr/bin/env bash

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ENV_NAME=$1
UNSAFE_FLAG=$2

# Validate environment name is provided
if [ -z "$ENV_NAME" ]; then
  echo ""
  echo -e "${RED}ERROR: Environment name not provided${NC}"
  echo "Usage: console_with_remote_db <environment> [--unsafe]"
  echo "Valid environments: staging, production"
  echo ""
  echo "Examples:"
  echo "  make run.console.on_staging_database"
  echo "  make run.console.on_production_database          # with sandbox"
  echo "  make run.console.on_production_database.unsafe   # without sandbox"
  echo ""
  exit 1
fi

# Validate only staging or production
if [ "$ENV_NAME" != "staging" ] && [ "$ENV_NAME" != "production" ]; then
  echo ""
  echo -e "${RED}ERROR: Invalid environment '$ENV_NAME'${NC}"
  echo "Valid environments: staging, production"
  echo ""
  exit 1
fi

# Check if DATABASE_URL_STAGING or DATABASE_URL_PRODUCTION is set
ENV_VAR_NAME="DATABASE_URL_$(echo $ENV_NAME | tr '[:lower:]' '[:upper:]')"
DATABASE_URL_VALUE="${!ENV_VAR_NAME}"

if [ -z "$DATABASE_URL_VALUE" ]; then
  echo ""
  echo -e "${RED}ERROR: $ENV_VAR_NAME not defined${NC}"
  echo "Please add it to your .env file:"
  echo ""
  echo -e "${YELLOW}$ENV_VAR_NAME=postgresql://user:pass@host:5432/dbname${NC}"
  echo ""
  exit 1
fi

# Prepare console command
export DATABASE_URL="$DATABASE_URL_VALUE"

if [ "$ENV_NAME" = "staging" ]; then
  # Staging: always without sandbox
  echo ""
  echo -e "${GREEN}Starting Rails console with $ENV_NAME database...${NC}"
  echo "Using: $ENV_VAR_NAME"
  echo ""
  bundle exec rails console

elif [ "$ENV_NAME" = "production" ]; then
  if [ "$UNSAFE_FLAG" = "--unsafe" ]; then
    # Production unsafe: without sandbox
    echo ""
    echo -e "${RED}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║  ⚠️  DANGER: PRODUCTION database in UNSAFE MODE!         ║${NC}"
    echo -e "${RED}║  All changes will be REAL and PERMANENT!                 ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${RED}Starting Rails console WITHOUT sandbox...${NC}"
    echo "Using: $ENV_VAR_NAME"
    echo ""
    bundle exec rails console
  else
    # Production safe: with sandbox
    echo ""
    echo -e "${YELLOW}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║  🛡️  SANDBOX MODE: Connected to PRODUCTION database      ║${NC}"
    echo -e "${YELLOW}║  All changes will be ROLLED BACK when you exit           ║${NC}"
    echo -e "${YELLOW}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${GREEN}Starting Rails console with sandbox mode...${NC}"
    echo "Using: $ENV_VAR_NAME"
    echo ""
    bundle exec rails console --sandbox
  fi
fi
