#!/usr/bin/env bash
set -euo pipefail

# Detect if running inside .commons itself or from a project using .commons
if [ -f "shell/tasks/ai/setup" ] && [ ! -d ".commons" ]; then
  # Running inside .commons repo directly
  COMMONS_DIR="."
  IS_COMMONS=true
else
  if [ ! -d ".commons" ]; then
    echo "Execute a partir da raiz do projeto"
    exit 1
  fi
  COMMONS_DIR=".commons"
  IS_COMMONS=false
fi

if [ ! -d "$COMMONS_DIR/ai/shared/skills" ] || [ ! -d "$COMMONS_DIR/ai/shared/commands" ]; then
  echo "Rode: git submodule update --init"
  exit 1
fi

mkdir -p .claude

clean_target() {
  local target="$1"

  if [ -L "$target" ] || [ -d "$target" ]; then
    rm -rf "$target"
  fi
}

symlink() {
  local target="$1"
  local dest="$2"

  ln -s "$dest" "$target"
  echo "✓ $target -> $dest"
}

if [ "$IS_COMMONS" = true ]; then
  # Inside .commons: skills and commands point directly to local dirs
  mkdir -p .project/ai
  clean_target ".project/ai/skills"
  clean_target ".project/ai/commands"
  symlink ".project/ai/skills" "../../ai/shared/skills"
  symlink ".project/ai/commands" "../../ai/shared/commands"

  clean_target ".claude/skills"
  symlink ".claude/skills" "../ai/shared/skills"

  clean_target ".claude/commands"
  mkdir -p .claude/commands
  symlink ".claude/commands/commons" "../../ai/shared/commands"
else
  # Inside a project: skills and commands point to project-local AI assets.
  clean_target ".claude/skills"
  clean_target ".claude/commands"
  clean_target ".codex/skills"
  clean_target ".codex/commands"

  mkdir -p .claude .codex .project/ai/skills .project/ai/commands
  touch .project/ai/skills/.gitkeep .project/ai/commands/.gitkeep
  symlink ".claude/skills" "../.project/ai/skills"
  symlink ".claude/commands" "../.project/ai/commands"
  symlink ".codex/skills" "../.project/ai/skills"
  symlink ".codex/commands" "../.project/ai/commands"
fi
